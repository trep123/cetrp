.search-bar{
  position: sticky;
  top: 20px;
  z-index: 50;
  display: flex;
  align-items: center;
  margin: 0 30px 20px;
  padding: 0 16px;
  height: 48px;
  background: rgba(40,40,40,.92);
  border: 1px solid #444;
  border-radius: 24px;
  box-shadow: 0 4px 20px rgba(0,0,0,.5);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  .search-icon{
    color: #00FFCC;
    font-size: 16px;
    flex-shrink: 0;
  }
  .search-input{
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-size: 14px;
    margin: 0 8px;
    height: 100%;
  }
  .search-input::placeholder{ color: #888; }
  .search-clear{
    display: none;
    cursor: pointer;
    color: #aaa;
    font-size: 20px;
    line-height: 1;
    padding: 0 4px;
    &:hover{ color: orange; }
  }
  .search-results{
    display: none;
    position: absolute;
    top: 54px;
    left: 0;
    right: 0;
    background: rgba(30,30,30,.98);
    border: 1px solid #444;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0,0,0,.7);
    max-height: 60vh;
    overflow-y: auto;
    padding: 6px;
    &.show{ display: block; }
    .search-item{
      display: block;
      padding: 10px 12px;
      border-radius: 8px;
      color: #ddd;
      transition: background .2s;
      &:hover{ background: rgba(255,165,0,.15); }
      .search-item-title{ display: block; color: #fff; font-size: 14px; margin-bottom: 3px; }
      .search-item-snippet{ display: block; color: #aaa; font-size: 12px; line-height: 1.5; }
      .search-tag{ display: inline-block; margin-top: 4px; font-size: 11px; color: #00FFCC; }
      mark{ background: orange; color: #000; padding: 0 2px; border-radius: 2px; }
    }
    .search-empty{ padding: 14px; text-align: center; color: #888; font-size: 13px; }
  }
}
