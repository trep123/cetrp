#container{
	position:relative;
	min-height:100%;
	#mobile-nav{
		display: none;
		.overlay{
			height: 110px;
			position: absolute;
			width: 100%;
			background: transparent;
			&.fixed{
				background: rgba(40,40,40,.92);
		        position: fixed;
		        height: 42px;
		        z-index: 99;
		    }
		}
		#header{
			padding: 10px 0 0 0;
			.profilepic{
				display: block;
				position: relative;
				z-index: 100;
			}
			.header-menu{
				height: auto;
				margin: 10px;
				ul{
					text-align: center;
					cursor: default;
				}
				li{
					display: inline-block;
					margin: 3px;
				}
			}
		}
	}
	.left-col {
		width: 300px;
		position: fixed;
		transition: all .2s ease-in;
		opacity: 0.8;
		top: 20px;
		left: 10px;
		bottom: 20px;

		-webkit-box-shadow: 0px 0px 30px #000;
		-moz-box-shadow: 0px 0px 30px #000;
		-ms-box-shadow: 0px 0px 30px #000;
		-o-box-shadow: 0px 0px 30px #000;
		box-shadow: 0px 0px 30px #000;
		-webkit-border-radius: 20px;
		-moz-border-radius: 20px;
		-ms-border-radius: 20px;
		-o-border-radius: 20px;
		border-radius: 20px;
		.intrude-less {
			width: 76%;
			box-sizing: border-box;
			text-align: center;
			margin: 30px auto;
			max-height: calc(100% - 60px);
			padding-top: 30px;
			padding-bottom: 30px;
			overflow-y: auto;
		}
		z-index: 1;
	}
	.mid-col {
		position:absolute;
		right:0;
		top: 0;
		min-height:100%;
		left: 300px;
		width: auto;
	}

	@media screen and (max-width:1040px) {

	}@media screen and (max-width:800px) {
		@import "_partial/mobile"
	}
}
.header-author{
	text-align: center;
	margin: 0.67em 0;
	font-family: Roboto, "Roboto", serif;
	font-size: 30px;
	transition: 0.3s;
}
#header{
	width:100%;
	a {
		color: #FFF;
		&:hover {
			color: #B0A0AA;
		}
	}
	.profilepic{
		text-align: center;
		display: block;
		box-shadow: 0 0 30px 2px #000;
		border-radius: 50%;
		padding: 10px;
		box-sizing: border-box;
		width: 128px;
		height: 128px;
		margin: 0 auto;
		position: relative;
		overflow: hidden;
		-webkit-transition: all .6s ease-in;
		display: -webkit-box;
		-webkit-box-orient: horizontal;
		-webkit-box-pack: center;
		-webkit-box-align: center;
		text-align: center;
		img{
			width: 20%;
			height: 20%;
			border-radius: 50%;
			opacity: 0;
			-webkit-transition: all .6s ease-in;
		}
		&.show{
			transform: rotateY(360deg);
			img {
				width: 100%;
				height: 100%;
				opacity: 1;
			}
		}
		&:hover{
			transform: rotateY(180deg);
		}
	}
	.header-subtitle{
		text-align: center;
		color: #00FFCC;
		font-weight: bolder;
		font-size: 16px;
		line-height: 25px;
		overflow: hidden;
		text-overflow: ellipsis;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
	}
	.header-subtitle:hover{
		color: #FF0099;
	}
	.header-menu{
		font-weight: 300;
		text-align: center;
		margin: 25px 0 10px;
		ul{
			list-style: none;
			padding: 0;
			margin: 0;
		}
		li{
			margin: 8px auto;
			padding: 0;
			a{
				display: inline-block;
				width: 80%;
				padding: 6px 0;
				font-size: 14px;
				color: #fff;
				-webkit-box-shadow: 0px 0px 10px 2px #000;
				-moz-box-shadow: 0px 0px 10px 2px #000;
				box-shadow: 0px 0px 10px 2px #000;
				border-radius: 10px;
				transition: color 0.3s;
			}
			a:hover{
				color: orange;
			}
		}
	}
	.left-block{
		margin: 22px auto;
		text-align: center;
		&:after{ content: ""; display: block; clear: both; }
	}
	.left-block-title{
		font-size: 14px;
		font-weight: bold;
		color: #00FFCC;
		margin-bottom: 12px;
		text-shadow: 0 0 6px rgba(0,255,204,.4);
	}
	.left-tags .tagcloud{
		line-height: 2.4;
	}
	/tag-count{
		background: rgba(0,0,0,.32);
		padding: 1px 6px;
		margin-left: 5px;
		border-radius: 8px;
		font-size: 11px;
		color: #fff;
		font-weight: bold;
	}
	.toys-list{
		list-style: none;
		padding: 0;
		margin: 0;
		li{
			margin: 6px 0;
			a{
				color: #fff;
				font-size: 14px;
				transition: color 0.3s;
			}
			a:hover{
				color: orange;
			}
		}
	}
	.header-nav{
		width: 100%;
		margin-top: 25px;
		padding-top: 15px;
		border-top: 1px dashed rgba(255,255,255,.15);
		.social{
			text-align: center;
			a{
				display: inline-block;
				margin: 0 10px;
				font-size: 22px;
				color: #fff;
				opacity: 0.7;
				transition: 0.3s;
				&:hover{
					opacity: 1;
					color: orange;
				}
			}
		}
	}
}

#particles-js {
	position: fixed;
	width: 100%;
	height: 100%;
	overflow: hidden;
}

.back-to-top{
	position: fixed;
	right: 30px;
	bottom: 30px;
	width: 42px;
	height: 42px;
	border-radius: 50%;
	background: rgba(77,77,77,.85);
	border: 1px solid #666;
	color: #fff;
	font-size: 18px;
	cursor: pointer;
	text-align: center;
	line-height: 42px;
	box-shadow: 0 0 15px rgba(0,0,0,.6);
	opacity: 0;
	visibility: hidden;
	transform: translateY(10px);
	transition: all 0.3s;
	z-index: 99;
	&.show{
		opacity: 0.9;
		visibility: visible;
		transform: translateY(0);
	}
	&:hover{
		background: rgba(255,165,0,.85);
		border-color: orange;
	}
}
