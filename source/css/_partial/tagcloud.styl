#header .tagcloud a{
    color:#fff;
}
.tagcloud{
    a{
        display:inline-block;
        text-decoration:none;
        font-weight: normal;
        font-size:12px;
        color:#fff;
        height:20px;
        line-height:20px;
        float: left;
        padding:0 8px 0px 14px;
        position:relative;
        border-radius:0 5px 5px 0;
        margin: 5px 6px;
        font-family: Menlo, Monaco, "Andale Mono", "lucida console", "Courier New", monospace;
        &:hover{ opacity: 0.85; }
        &:before{
            content: " ";
            width: 0px;
            height: 0px;
            position: absolute;
            top: 0;
            left: -14px;
            border: 10px solid transparent;
        }
        &:after{
            content:" ";
            width:4px;
            height:4px;
            background-color:#fff;
            border-radius:4px;
            box-shadow:0px 0px 0px 1px rgba(0,0,0,.3);
            position:absolute;
            top: 8px;
            left: 2px;
        }
    }
    .tag-count{
        background: rgba(0,0,0,.32);
        padding: 1px 6px;
        margin-left: 5px;
        border-radius: 8px;
        font-size: 11px;
        color: #fff;
        font-weight: bold;
    }
    a.color1{ background: #FF945C; &:before{ border-right-color: #FF945C; } }
    a.color2{ background: #F5C7B7; &:before{ border-right-color: #F5C7B7; } }
    a.color3{ background: #BA8F6C; &:before{ border-right-color: #BA8F6C; } }
    a.color4{ background: #CFB7C4; &:before{ border-right-color: #CFB7C4; } }
    a.color5{ background: #7B5D5F; &:before{ border-right-color: #7B5D5F; } }
}

.article-tag{
    float: left;
    margin-right: 6px;
    .article-tag-list{
        padding-left: 0;
        .article-tag-list-item{
            display: inline-block;
            margin: 4px 12px 4px 0;
            list-style: none;
        }
        .article-tag-list-link{
            display: inline-block;
            font-size: 12px;
            color: #fff;
            height: 20px;
            line-height: 20px;
            padding: 0 8px 0 14px;
            position: relative;
            border-radius: 0 5px 5px 0;
            transition: opacity .2s;
            &:hover{ opacity: 0.85; }
            &:before{
                content: " ";
                width: 0;
                height: 0;
                position: absolute;
                top: 0;
                left: -14px;
                border: 10px solid transparent;
            }
            &:after{
                content: " ";
                width: 4px;
                height: 4px;
                background-color: #fff;
                border-radius: 4px;
                box-shadow: 0 0 0 1px rgba(0,0,0,.3);
                position: absolute;
                top: 8px;
                left: 2px;
            }
        }
    }
}
.article-tag-list-item:nth-child(5n+1) .article-tag-list-link{ background: #FF945C; &:before{ border-right-color: #FF945C; } }
.article-tag-list-item:nth-child(5n+2) .article-tag-list-link{ background: #F5C7B7; &:before{ border-right-color: #F5C7B7; } }
.article-tag-list-item:nth-child(5n+3) .article-tag-list-link{ background: #BA8F6C; &:before{ border-right-color: #BA8F6C; } }
.article-tag-list-item:nth-child(5n+4) .article-tag-list-link{ background: #CFB7C4; &:before{ border-right-color: #CFB7C4; } }
.article-tag-list-item:nth-child(5n+5) .article-tag-list-link{ background: #7B5D5F; &:before{ border-right-color: #7B5D5F; } }
.article-category{
    float: left;
    &:before{
        float: left;
        color: #999;
        content: "\f02d";
        font: 900 16px "Font Awesome 6 Free";
        margin-right: 10px;
        margin-top: 9px;
    }
    &:after{
        float: left;
        content: "";
        margin-right: 20px;
        margin-top: 9px;
    }
}
.article-pop-out {
    float: left;
    &:before{
        float: left;
        color: #999;
        content: "\f08d";
        font: 900 16px "Font Awesome 6 Free";
        margin-right: 10px;
        margin-top: 9px;
    }
    &:after{
        float: left;
        content: "";
        margin-right: 20px;
        margin-top: 9px;
    }
}

.title-pop-out {
    font-size: 16px;
}
