.body-wrap{
  padding-top: 30px;
  margin-bottom: 80px;
}
.article {
  margin: 10px 30px 30px 30px;
  position: relative;
  -webkit-box-shadow: 0px 0px 30px 10px #000;
  -moz-box-shadow: 0px 0px 30px 10px #000;
  -ms-box-shadow: 0px 0px 30px 10px #000;
  -o-box-shadow: 0px 0px 30px 10px #000;
  box-shadow: 0px 0px 30px 10px #000;
  -webkit-border-radius: 20px;
  -moz-border-radius: 20px;
  -ms-border-radius: 20px;
  -o-border-radius: 20px;
  border-radius: 20px;
  -webkit-transition: all 0.2s ease-in;
  &.show{
    visibility: visible;
    -webkit-animation: cd-bounce-1 0.6s;
    -moz-animation: cd-bounce-1 0.6s;
    animation: cd-bounce-1 0.6s;
  }
  &.hidden{
    visibility: hidden;
  }
  img{
    max-width: 90%;
    display: block;
    margin: 10px auto;
  }
}
@-webkit-keyframes cd-bounce-1 {
  0% { opacity: 0; -webkit-transform: scale(1); }
  60% { opacity: 1; -webkit-transform: scale(1.01); }
  100% { -webkit-transform: scale(1); }
}
@-moz-keyframes cd-bounce-1 {
  0% { opacity: 0; -moz-transform: scale(1); }
  60% { opacity: 1; -moz-transform: scale(1.01); }
  100% { -moz-transform: scale(1); }
}
@keyframes cd-bounce-1 {
  0% { opacity: 0; -webkit-transform: scale(1); -moz-transform: scale(1); -ms-transform: scale(1); -o-transform: scale(1); transform: scale(1); }
  60% { opacity: 1; -webkit-transform: scale(1.01); -moz-transform: scale(1.01); -ms-transform: scale(1.01); -o-transform: scale(1.01); transform: scale(1.01); }
  100% { -webkit-transform: scale(1); -moz-transform: scale(1); -ms-transform: scale(1); -o-transform: scale(1); transform: scale(1); }
}

.article-title {
  color: orange;
  margin-left: 0px;
  font-weight: 300;
  line-height: 35px;
  margin-bottom: 20px;
  font-size: 26px;
  -webkit-transition: color 0.3s;
  -moz-transition: color 0.3s;
  -o-transition: color 0.3s;
  transition: color 0.3s;
  &:hover{ color: #B0A0AA; }
}

.article-inner{
  position: relative;
  margin-bottom: 20px;
}
.article-header{
  border-left: 5px solid orange;
  border-top-left-radius: 20px;
  padding: 15px 0px 15px 25px;
}

.article-info.info-on-left{
  margin: 10px 0 0 0;
  float: left;
}
.article-info-index.article-info{
  padding-top: 20px;
  margin: 30px 30px 0 30px;
  border-top: 1px solid #555;
}
.article-info-post.article-info{
  padding: 0
  border: none;
  margin: -30px 0 20px 30px;
}
.article-entry{
  line-height: 1.8em;
  padding-right: 30px;
  padding-left: 30px;
  p{ margin-top: 10px; }
  p code,li code{
    padding: 2px 5px;
    margin: 0 2px;
    background: #3a3a3a;
    border: 1px solid #555;
    border-radius: 3px;
    color: #EEF8FC;
    font-family: font-mono;
    word-wrap: break-word;
    font-size: 14px;
  }
  blockquote {
    padding: 15px 20px;
    margin-top: 10px;
    border-left: 5px solid #657b83;
    p{ margin-top: 0; }
  }
  em { font-style: italic; }
  ul{
    li:before{
      content: "";
      width: 6px;
      height: 6px;
      border: 1px solid #999;
      border-radius: 10px;
      background: #aaa;
      display: inline-block;
      margin-right: 10px;
      float: left;
      margin-top: 12px;
    }
  }
  ul,ol{
    font-size: 16px;
    margin: 10px 0px;
  }
  li{
    ul,ol{
      margin-left: 30px;
      li:before{
        content: "";
        background: #dedede;
      }
    }
  }
  h1{
    margin-top: 30px;
    color: orange;
    font-size: 1.5em;
    font-weight: bold;
  }
  h2{
    margin-top: 22px;
    font-weight: bold;
    color: #ffb733;
    font-size: 1.3em;
    padding-bottom: 5px;
    border-bottom: 1px solid #555;
  }
  h3{
    margin-top: 20px;
    font-weight: bold;
    color: #ffd;
    font-size: 1.15em;
    padding-bottom: 4px;
    border-bottom: 1px solid #444;
  }
  h4,h5,h6{
    margin-top: 18px;
    font-weight: bold;
    color: #eee;
    font-size: 1em;
  }
  video{ max-width: 100%; }
  strong { font-weight: bold; }
  .caption{ display: block; font-size: 0.8em; color: #aaa; }
  hr{
    height: 0;
    margin-top: 20px;
    margin-bottom: 20px;
    border-left: 0;
    border-right: 0;
    border-top: 1px solid #555;
    border-bottom: 1px solid #222;
  }
  pre {
    font-size: 14px;
    line-height: 1.5;
    margin-top: 10px;
    padding: 12px 14px;
    overflow-x: auto;
    background: #282a36;
    color: #f8f8f2;
    border-radius: 6px;
    border: 1px solid #44475a;
    font-family: font-mono;
    code{
      font-size: 14px;
      background: none;
      color: inherit;
      padding: 0;
      border: none;
    }
  }
  .code-toolbar{
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    gap: 4px;
    z-index: 3;
  }
  .code-copy-btn, .code-fold-btn{
    background: rgba(68,71,90,.9);
    border: 1px solid #6272a4;
    color: #f8f8f2;
    border-radius: 3px;
    padding: 3px 7px;
    font-size: 12px;
    cursor: pointer;
    transition: .2s;
    &:hover{
      background: rgba(255,165,0,.2);
      border-color: orange;
      color: orange;
    }
  }
  .code-expand-btn{
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    display: none;
    background: rgba(40,42,54,.95);
    border: 1px solid #6272a4;
    color: #f8f8f2;
    border-radius: 3px;
    padding: 3px 12px;
    font-size: 12px;
    cursor: pointer;
    z-index: 3;
    transition: .2s;
    &:hover{
      background: rgba(255,165,0,.2);
      border-color: orange;
      color: orange;
    }
  }
  figure.highlight, pre{
    transition: max-height .35s ease;
  }
  figure.highlight.collapsed, pre.collapsed{
    max-height: 130px;
    overflow: hidden;
    .code-expand-btn{ display: block; }
    &::after{
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 55px;
      background: linear-gradient(to bottom, transparent, #282a36);
      pointer-events: none;
      z-index: 1;
    }
  }
  table{
    width: 100%;
    border: 1px solid #444;
    margin: 15px 0;
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
    tr,td{ height: 35px; }
    thead{ tr { background: #3a3a3a; } }
    tbody{
      tr:nth-child(even){ background: #333; }
      tr:hover{ background: #3a3a3a; }
    }
    td,th{
      border: 1px solid #444;
      padding: 0 12px;
      color: #eee;
    }
    th{ color: #00FFCC; }
  }
  figure{
    table {
      border: none;
      width: auto;
      margin: 0;
      display: table;
      overflow: visible;
      tbody{ tr:hover{ background: none; } }
    }
  }
}

.article-meta{
  width: 150px;
  font-size: 14px;
  text-align: right;
  position: absolute;
  right: 0;
  top: 23px;
  text-align: center;
  z-index: 1;
  time{
    color: #00FFFF;
    &:before{
      color: #00FFFF;
      content: "\f073";
      font-family: "Font Awesome 6 Free";
      font-weight: 900;
      margin-right: 10px;
    }
  }
}

.article-more-link{
  text-align: right;
  padding-bottom: 20px;
  padding-right: 20px;
  a{
    background: #4d4d4d;
    color: #fff;
    font-size: 12px;
    padding: 2px 8px 4px;
    line-height: 16px;
    -webkit-border-radius: 2px;
    -moz-border-radius: 2px;
    border-radius: 2px;
    transition: background 0.3s;
    &:hover{ background: #3c3c3c; }
    &.hidden{ visibility: hidden; }
  }
}

#article-nav{
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 20px 30px 40px;
  .article-nav-card{
    flex: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    box-sizing: border-box;
    padding: 16px 18px;
    background: rgba(77,77,77,.4);
    border: 1px solid #444;
    border-radius: 10px;
    box-shadow: 0 0 15px rgba(0,0,0,.5);
    transition: all 0.3s;
    color: #fff;
    min-width: 0;
    .nav-arrow{ font-size: 18px; color: #999; flex-shrink: 0; }
    .nav-content{ display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
    .nav-label{ font-size: 12px; color: orange; margin-bottom: 4px; }
    .nav-title{ font-size: 14px; color: #eee; line-height: 1.5; word-break: break-word; }
    &.nav-next{ text-align: right; .nav-content{ align-items: flex-end; } }
    &:only-child{
      flex: 0 0 48%;
      max-width: 48%;
    }
    &.nav-prev:only-child{ margin-right: auto; }
    &.nav-next:only-child{ margin-left: auto; }
    &:hover{
      transform: translateY(-2px);
      border-color: orange;
      box-shadow: 0 4px 20px rgba(255,165,0,.3);
      .nav-arrow{ color: orange; }
    }
  }
}

.article-copyright{
  margin: 20px 30px;
  padding: 16px 20px;
  background: rgba(0,0,0,.25);
  border: 1px solid #444;
  border-left: 4px solid orange;
  border-radius: 8px;
  font-size: 13px;
  color: #aaa;
  .copyright-row{
    margin: 6px 0;
    i{ margin-right: 8px; color: #00FFCC; width: 16px; }
    a{ color: #ffb733; word-break: break-all; }
  }
}

.not-found-container{
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  z-index: 10;
  .not-found-code{
    font-size: 120px;
    font-weight: bold;
    color: orange;
    text-shadow: 0 0 30px rgba(255,165,0,.5);
    margin: 0;
    line-height: 1;
  }
  .not-found-text{
    color: #aaa;
    font-size: 18px;
    margin: 20px 0 30px;
  }
  .not-found-btn{
    display: inline-block;
    padding: 10px 24px;
    background: rgba(77,77,77,.6);
    border: 1px solid orange;
    border-radius: 20px;
    color: orange;
    font-size: 14px;
    transition: .2s;
    &:hover{
      background: rgba(255,165,0,.15);
    }
  }
}

.post-meta-extra{
  margin: 0 30px 16px;
  padding: 8px 0;
  border-top: 1px dashed #444;
  border-bottom: 1px dashed #444;
  font-size: 13px;
  color: #aaa;
  .dot{ margin: 0 8px; color: #555; }
  i{ margin-right: 5px; color: #00FFCC; }
}

.post-toc{
  margin: 0 30px 20px;
  padding: 14px 18px;
  background: rgba(0,0,0,.25);
  border: 1px solid #444;
  border-radius: 8px;
  font-size: 14px;
  .post-toc-header{
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    .post-toc-title{ color: #00FFCC; font-weight: bold; i{ margin-right: 6px; } }
    .post-toc-toggle{ font-size: 12px; color: #888; cursor: pointer; &:hover{ color: orange; } }
  }
  .post-toc-body{
    max-height: 420px;
    overflow-y: auto;
    transition: max-height .3s ease;
    ol{ list-style: none; padding-left: 16px; margin: 0; }
    a{ color: #ccc; line-height: 1.9; display: block; &:hover{ color: orange; } }
  }
  &.collapsed .post-toc-body{ height: 0; padding-top: 0; padding-bottom: 0; overflow: hidden; }
}

.copy-link-wrap{
  margin: 10px 30px 20px;
  text-align: center;
  .copy-link-btn{
    display: inline-block;
    padding: 8px 20px;
    background: #4d4d4d;
    color: #fff;
    border: 1px solid #666;
    border-radius: 3px;
    cursor: pointer;
    font-size: 13px;
    transition: all 0.3s;
    i{ margin-right: 6px; }
    &:hover{ background: #5e5e5e; border-color: orange; color: orange; }
    &.copied{ background: #2d8f4e; border-color: #2d8f4e; }
  }
}
