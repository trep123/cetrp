<% if (theme.fancybox){ %>
  <%- css('fancybox/jquery.fancybox') %>
<% } %>

<%- js('https://cdn.bootcdn.net/ajax/libs/require.js/2.3.2/require.min.js') %>
<%- js('https://cdn.bootcdn.net/ajax/libs/jquery/3.1.1/jquery.min.js') %>

<script>
	var pixieConfig = {
		fancybox: <%=theme.fancybox%>,
		mathjax: <%=theme.mathjax%>,
		animate: <%=theme.animate%>,
		isHome: <%=is_home()%>,
		isPost: <%=is_post()%>,
		isArchive: <%=is_archive()%>,
		isTag: <%=is_tag()%>,
		isCategory: <%=is_category()%>,
		open_in_new: <%=theme.open_in_new%>
	}
</script>
<%- js('js/main') %>
<script>require(['/js/search.js'], function(s){ s && s.init && s.init(); });</script>


