<nav class="post-toc" id="post-toc">
  <div class="post-toc-header">
    <span class="post-toc-title"><i class="fa-solid fa-list-ul"></i> 目录</span>
    <span class="post-toc-toggle" id="post-toc-toggle">折叠</span>
  </div>
  <div class="post-toc-body" id="post-toc-body"><%- tocHtml %></div>
</nav>
<script>
(function(){
  var toggle = document.getElementById('post-toc-toggle');
  var toc = document.getElementById('post-toc');
  if(!toggle || !toc) return;
  toggle.style.cursor = 'pointer';
  toggle.addEventListener('click', function(){
    var collapsed = toc.classList.toggle('collapsed');
    toggle.textContent = collapsed ? '展开' : '折叠';
  });
})();
</script>
