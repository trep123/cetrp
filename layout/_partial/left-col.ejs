<div class="overlay"></div>
<div class="intrude-less">
	<header id="header" class="inner">
		<a href="/" class="profilepic">
			<% if (theme.animate){ %>
			<img lazy-src="<%=theme.avatar%>" class="js-avatar">
			<%}else{%>
			<img src="<%=theme.avatar%>" class="js-avatar" style="width: 100%;height: 100%;opacity: 1;">
			<%}%>
		</a>

		<hgroup>
		  <h1 class="header-author"><a href="/"><%= config.author || config.title %></a></h1>
		</hgroup>

		<% if (config.subtitle){ %>
		<p class="header-subtitle"><%= config.subtitle %></p>
		<%}%>

		<nav class="header-menu">
			<ul>
			<% for (var i in theme.menu){ %>
				<li><a href="<%- url_for(theme.menu[i]) %>"><%= i %></a></li>
	        <%}%>
			</ul>
		</nav>

		<% if (theme.tagcloud){ %>
		<section class="left-block left-tags">
			<h2 class="left-block-title">标签</h2>
			<div class="widget tagcloud" id="js-tagcloud">
				<% site.tags.each(function(tag, idx){ %>
					<a href="<%- url_for(tag.path) %>" class="color<%= idx % 5 + 1 %>"><%= tag.name %><span class="tag-count"><%= tag.length %></span></a>
				<% }) %>
			</div>
		</section>
		<%}%>

		<% if (theme['sth-interesting'] && theme['sth-interesting'].length){ %>
		<section class="left-block left-toys">
			<h2 class="left-block-title"><%= theme['sth-interesting-title'] || '一些小玩意儿' %></h2>
			<ul class="toys-list" id="js-toys">
				<% theme['sth-interesting'].forEach(function(item){ %>
					<li><a href="<%- url_for(item.url) %>" target="_blank" rel="noopener"><%= item.name %></a></li>
				<%})%>
			</ul>
		</section>
		<%}%>

		<nav class="header-nav">
			<div class="social">
				<% for (var i in theme.subnav){ %>
					<a class="social-<%= i %>" target="_blank" href="<%- url_for(theme.subnav[i]) %>" title="<%= i %>" aria-label="<%= i %>"><i class="fa-brands fa-<%= i %>" aria-hidden="true"></i></a>
		        <%}%>
			</div>
		</nav>
	</header>
</div>
