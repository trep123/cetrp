<%
  var _copy = (theme.copy_template || '{title}\n作者：{author}\n链接：{url}\n来源：{site}\n本文采用 {license} 进行许可，转载请注明出处。')
    .replace(/{title}/g, (post && post.title) || (page && page.title) || '')
    .replace(/{author}/g, config.author || '')
    .replace(/{url}/g, config.url + url_for(post && post.path || page && page.path || ''))
    .replace(/{site}/g, config.title || '')
    .replace(/{license}/g, theme.copy_license || '');
%>
<div class="copy-link-wrap">
  <button class="copy-link-btn" id="pixie-copy-link" type="button">
    <i class="fa-solid fa-link"></i> <span class="copy-label">复制本文链接</span>
  </button>
</div>
<script>
(function(){
  var btn = document.getElementById('pixie-copy-link');
  if(!btn) return;
  var text = <%- JSON.stringify(_copy) %>;
  function done(){
    var lb = btn.querySelector('.copy-label');
    var old = lb.textContent;
    lb.textContent = '✓ 已复制';
    btn.classList.add('copied');
    setTimeout(function(){ lb.textContent = old; btn.classList.remove('copied'); }, 2000);
  }
  function fallback(){
    var ta = document.createElement('textarea');
    ta.value = text; ta.style.position='fixed'; ta.style.top='-9999px';
    document.body.appendChild(ta); ta.focus(); ta.select();
    try{ document.execCommand('copy'); done(); }catch(e){}
    document.body.removeChild(ta);
  }
  btn.addEventListener('click', function(){
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(done).catch(fallback);
    } else { fallback(); }
  });
})();
</script>
