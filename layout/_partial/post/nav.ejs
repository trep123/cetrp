<% if (post.prev || post.next){ %>
<nav id="article-nav">
  <% if (post.prev){ %>
    <a href="<%- url_for(post.prev.path) %>" id="article-nav-newer" class="article-nav-card nav-prev">
      <span class="nav-arrow"><i class="fa-solid fa-arrow-left"></i></span>
      <span class="nav-content">
        <span class="nav-label">上一篇</span>
        <span class="nav-title"><%= post.prev.title ? post.prev.title : '(无标题)' %></span>
      </span>
    </a>
  <% } %>
  <% if (post.next){ %>
    <a href="<%- url_for(post.next.path) %>" id="article-nav-older" class="article-nav-card nav-next">
      <span class="nav-content">
        <span class="nav-label">下一篇</span>
        <span class="nav-title"><%= post.next.title ? post.next.title : '(无标题)' %></span>
      </span>
      <span class="nav-arrow"><i class="fa-solid fa-arrow-right"></i></span>
    </a>
  <% } %>
</nav>
<% } %>
